# Site address. Set by docker-compose from DOMAIN in .env:
#   DOMAIN unset/blank -> ":80"  -> plain HTTP on every IP, no certificate
#   DOMAIN=example.com -> the domain -> automatic HTTPS via Let's Encrypt
# Caddy only attempts a certificate when the address carries a hostname, so
# the IP-only mode needs no DNS record and never touches port 443.
{$SITE_ADDRESS::80} {
    # Prometheus metrics - token protected
    @metrics {
        path /metrics/*
        header X-Metrics-Token {$METRICS_TOKEN:}
    }
    handle @metrics {
        uri strip_prefix /metrics
        reverse_proxy prometheus:9090
    }
    handle /metrics/* {
        respond "Unauthorized" 401
    }

    # Reverse proxy to API
    reverse_proxy api:3000

    # Compression
    encode gzip

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Logging
    log {
        output stdout
        format json
    }
}
